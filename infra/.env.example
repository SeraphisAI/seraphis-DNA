KATOPU_API_PORT=8000
KATOPU_UI_PORT=8501
KATOPU_API_BASE=http://api:8000

# Optional (set to enforce API key)
# KATOPU_API_KEY=change-me

KATOPU_TELEMETRY_ENABLED=false
KATOPU_TELEMETRY_SAMPLE_RATE=0.1
KATOPU_TELEMETRY_PATH=/data/telemetry.jsonl
KATOPU_POLICY_AUDIT_PATH=/data/policy_audit.jsonl

# Rate limit (per IP)
KATOPU_RATE_RPS=5
KATOPU_RATE_BURST=10

# Policy override + UI policy editor
KATOPU_POLICY_OVERRIDE_PATH=/data/policy_override.json
KATOPU_POLICY_MUTABLE=false
